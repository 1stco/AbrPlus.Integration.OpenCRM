<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>AbrPlus.Integration.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>AbrPlus.Integration.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Company>AbrPlus</Company>
    <Authors>AbrPlus</Authors>
    <Owners>AbrPlus</Owners>
    <Version>1.0.24</Version>
    <AssemblyVersion>1.0.24</AssemblyVersion>
    <FileVersion>1.0.24</FileVersion>
    <Description>Copyright © AbrPlus 2026</Description>
    <RepositoryUrl>https://github.com/1stco/AbrPlus.Integration.OpenCRM</RepositoryUrl>
    <Description>REST client for AbrPlus OpenCRM contracts</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <OutputPath>..\.nuget\Publish\</OutputPath>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Refit" Version="8.0.0" />
    <PackageReference Include="AbrPlus.Platform.Client" Version="1.1.26" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="AbrPlus.Integration.OpenCRM" Version="1.0.24" />
  </ItemGroup>

</Project>
